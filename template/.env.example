# T40 Client Environment — deployment configuration.
#
#   cp .env.example .env
#
# Never commit .env. Every value here is either generated on the box or read
# from 1Password. Nothing in this file is a real secret.

# --- identity ---------------------------------------------------------------

# Used to name the Docker project, so one box could hold more than one.
APP_NAME=acme-environment

# The public hostname. Magic link emails are built from this, so it must be
# the address people actually use, including https://.
APP_HOST=https://acme.example.com

# Thruster requests a Let's Encrypt certificate for this name. Leave it empty
# on a local box with no public DNS and reach the app over Tailscale.
TLS_DOMAIN=acme.example.com

# --- secrets ----------------------------------------------------------------

# rails secret, or: openssl rand -hex 64
SECRET_KEY_BASE=

# --- database ---------------------------------------------------------------

POSTGRES_USER=t40
POSTGRES_DB=t40_production
# openssl rand -base64 32
POSTGRES_PASSWORD=

# The host is the compose service name, not localhost. Keep all four in step
# with POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above.
DATABASE_URL=postgres://t40:CHANGE_ME@db:5432/t40_production
CACHE_DATABASE_URL=postgres://t40:CHANGE_ME@db:5432/t40_production_cache
QUEUE_DATABASE_URL=postgres://t40:CHANGE_ME@db:5432/t40_production_queue
CABLE_DATABASE_URL=postgres://t40:CHANGE_ME@db:5432/t40_production_cable

# --- mail -------------------------------------------------------------------
#
# Passwordless sign-in is the only way in. If mail stops working, every user
# is locked out, including T40. Test it before handing the environment over.
#
# AWS SES SMTP credentials are NOT your AWS access keys. Create them under
# SES → SMTP settings → Create SMTP credentials.

# Must be an address or domain the provider has verified. SES rejects
# anything else, and the failure looks like sign-in silently not working.
MAIL_FROM=no-reply@acme.example.com

SMTP_ADDRESS=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- optional ---------------------------------------------------------------

# Stamped into logs and audit events so you can tell what was running.
RELEASE_SHA=

# 1 enforces the Content Security Policy. 0 reports violations without
# blocking — useful only while first bringing a new environment up.
T40_CSP_ENFORCE=1
